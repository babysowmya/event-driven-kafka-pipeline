# Copy this file to ".env" before running docker-compose.
# docker-compose automatically loads a file named ".env" in the project root.

# ---- PostgreSQL ----
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=pipeline_pass
POSTGRES_DB=activity_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Kafka ----
KAFKA_BROKER_URL=kafka:29092
KAFKA_TOPIC=user_activities
KAFKA_GROUP_ID=activity_aggregator_group

# ---- Producer tuning (seconds between events; randomized in this range) ----
PRODUCE_DELAY_MIN=0.2
PRODUCE_DELAY_MAX=1.0

# ---- API ----
API_PORT=8000